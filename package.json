{
  "name": "slf-monorepo",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "packages/*",
    "shared/*"
  ],
  "scripts": {
    "test": "turbo run test",
    "build": "turbo run build",
    "build:watch": "turbo run build:watch",
    "dev": "turbo run build:watch --parallel"
  },
  "devDependencies": {
    "turbo": "^2.9.6"
  }
}
