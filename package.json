{
  "name": "slf-monorepo",
  "private": true,
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=26",
    "npm": ">=11.5.1"
  },
  "workspaces": [
    "packages/*",
    "shared/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "test": "turbo run test",
    "test:resolution": "npm run build && node --test scripts/package-resolution.test.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check-style": "biome check --write .",
    "check-style:ci": "biome check .",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.9.6",
    "typescript-legacy": "npm:typescript@^5.9.3"
  }
}
