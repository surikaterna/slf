    "eslint": "^2.2.0",
    "eslint-config-surikat": "^1.1.1",
    "jest": "^28.1.3",
    "rimraf": "^3.0.2",
    "ts-jest": "^28.0.8",
    "typescript": "^6.0.3"
  },
  "bugs": {
