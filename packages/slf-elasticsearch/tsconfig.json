{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "typeRoots": ["./node_modules/@types", "./types"],
    "module": "esnext",
    "lib": ["esnext"],
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "emitDeclarationOnly": true,
    "types": ["jest"],
    "skipLibCheck": true
  },
  "include": ["src", "types"]
}
