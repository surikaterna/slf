{
  "name": "slf-sentry",
  "version": "2.4.0",
  "description": "Surikat Log Facade, sentry driver",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rimraf lib && tsc -p tsconfig.json",
    "build:watch": "rimraf lib && tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .js,.ts",
    "format": "prettier --write src",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surikaterna/slf-sentry.git"
  },
  "keywords": [
    "slf",
    "logging",
    "debug",
    "sentry"
  ],
  "author": "Surikaterna",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/surikaterna/slf-sentry/issues"
  },
  "homepage": "https://github.com/surikaterna/slf-sentry#readme",
  "devDependencies": {
    "@types/node": "^18.7.15",
    "@repo/tsconfig": "1.0.0",
    "eslint": "^8.23.0",
    "eslint-config-surikat": "^4.0.0",
    "prettier": "^2.7.1",
    "prettier-config-surikaterna": "^1.0.1",
    "rimraf": "^3.0.2",
    "slf": "^2.0.3",
    "slf-debug": "^0.3.1",
    "typescript": "^6.0.3",
    "vitest": "latest"
  },
  "dependencies": {
    "@sentry/node": "^7.120.3"
  },
  "peerDependencies": {
    "slf": "^2.0.3",
    "slf-debug": "^0.3.1"
  }
}
