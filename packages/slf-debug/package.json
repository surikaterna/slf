{
  "name": "slf-debug",
  "version": "0.3.1",
  "description": "Surikat Log Facade, debug-js/debug driver",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "jest --colors",
    "test:watch": "npm test -- --watch",
    "build": "rimraf lib && concurrently \"npm run build:src\" \"npm run build:types\"",
    "build:watch": "rimraf lib && concurrently \"npm run build:src:watch\" \"npm run build:types:watch\"",
    "build:src": "swc src --out-dir lib",
    "build:src:watch": "npm run build:src -- --watch",
    "build:types": "tsc",
    "build:types:watch": "npm run build:types -- --watch",
    "lint": "eslint src --ext .js,.ts",
    "format": "prettier --write src",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surikaterna/slf-debug.git"
  },
  "keywords": [
    "slf",
    "logging",
    "debug"
  ],
  "author": "Surikaterna",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/surikaterna/slf-debug/issues"
  },
  "homepage": "https://github.com/surikaterna/slf-debug#readme",
  "dependencies": {
    "debug": "^4.3.4"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.57",
    "@swc/core": "^1.2.248",
    "@swc/jest": "^0.2.22",
    "@types/debug": "^4.1.7",
    "@types/jest": "^29.0.0",
    "@types/node": "^18.7.15",
    "concurrently": "^7.3.0",
    "eslint": "^8.23.0",
    "eslint-config-surikat": "^4.0.0",
    "jest": "^29.0.2",
    "prettier": "^2.7.1",
    "prettier-config-surikaterna": "^1.0.1",
    "rimraf": "^3.0.2",
    "slf": "^2.0.3",
    "typescript": "^4.8.2"
  },
  "peerDependencies": {
    "slf": "^2.0.0"
  }
}
