{
  "name": "slf-debug",
  "version": "0.3.1",
  "description": "Surikat Log Facade, debug-js/debug driver",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsdown",
    "dev": "tsdown watch",
    "prepare": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surikaterna/slf.git",
    "directory": "packages/slf-debug"
  },
  "keywords": [
    "slf",
    "logging",
    "debug"
  ],
  "author": "Surikaterna",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/surikaterna/slf/issues"
  },
  "homepage": "https://github.com/surikaterna/slf#readme",
  "dependencies": {
    "debug": "^4.3.4"
  },
  "devDependencies": {
    "@repo/tsconfig": "*",
    "@repo/tsdown": "*",
    "@types/debug": "^4.1.7",
    "@types/node": "^18.7.15",
    "rimraf": "^6.1.3",
    "slf": "^2.0.3",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "slf": "^2.0.0"
  }
}
