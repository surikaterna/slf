{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": ["**", "!**/lib", "!**/.turbo"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noStaticOnlyClass": "off",
        "useArrowFunction": "off",
        "useDateNow": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUnusedVariables": "off"
      },
      "style": {
        "recommended": true,
        "useConst": "off",
        "useImportType": "off",
        "useShorthandFunctionType": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noRedeclare": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 320
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/slf/src/Logger.ts", "packages/slf/src/LoggerFactory.ts", "packages/slf-sentry/src/createSlfSentryDriver.ts"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
